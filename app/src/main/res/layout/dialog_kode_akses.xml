<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Judul Dialog -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kode Akses Database"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:layout_marginBottom="16dp" />

    <!-- TextBox 1: Link Database -->
    <EditText
        android:id="@+id/etLinkDatabase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Masukkan link database"
        android:inputType="textUri"
        android:textSize="14sp"
        android:padding="12dp"
        android:layout_marginBottom="12dp" />

    <!-- TextBox 2: Kode Autentikator -->
    <EditText
        android:id="@+id/etKodeAuth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Masukkan kode autentikator"
        android:inputType="textPassword"
        android:textSize="14sp"
        android:padding="12dp"
        android:layout_marginBottom="24dp" />

    <!-- Layout Tombol -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <!-- Button 1: Kembali -->
        <Button
            android:id="@+id/btnKembali"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kembali"
            android:layout_marginEnd="8dp" />

        <!-- Button 2: Dinamis (OK / Hapus) -->
        <Button
            android:id="@+id/btnAksi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OK" />

    </LinearLayout>

</LinearLayout>